# MLX Inference Server Dockerfile (Apple Silicon)
FROM python:3.11-slim

WORKDIR /app

COPY classifier/inference_http.py /app/

# Install MLX - requires Apple Silicon
RUN pip install --no-cache-dir mlx numpy

COPY classifier/mlx_server.py /app/
COPY classifier/traffic_classifier.npz /app/

ENV HOST=0.0.0.0
ENV PORT=50052

EXPOSE 50052

CMD ["python", "mlx_server.py", "--host", "0.0.0.0", "--port", "50052"]
